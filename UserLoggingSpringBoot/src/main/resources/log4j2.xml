<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">	
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern = "%d{yyy-MM-dd HH:mm:ss} %-5level [%t] %logger - %msg%n"></PatternLayout>
		</Console>
		<File name="FileAppender" filename="logs/app.log" append="true">
		<PatternLayout pattern = "%d{yyy-MM-dd HH:mm:ss} %-5level [%t] %logger - %msg%n"/>
		</File>
	</Appenders>	
	<Loggers>
		<Root level="info">
			<AppenderRef ref="Console"/>
			<AppenderRef ref="FileAppender"/>
		</Root>
	</Loggers>
</Configuration>